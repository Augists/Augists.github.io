---
import { getCollection } from "astro:content";
import type { BlogType } from "../../../content.config";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { siteConfig } from "../../../config/site";
import ArchiveDynamic from "../../../components/ArchiveDynamic.astro";

const blogs: BlogType[] = await getCollection("posts");
const years = [
  ...new Set(blogs.map((blog) => new Date(blog.data.date).getFullYear())),
].sort((a, b) => Number(b) - Number(a));

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const blogs: BlogType[] = await getCollection("posts");
  const years = [
    ...new Set(blogs.map((blog) => new Date(blog.data.date).getFullYear())),
  ];

  return years.flatMap((year) => {
    const filteredBlogs = blogs
      .filter((blog) => new Date(blog.data.date).getFullYear() === Number(year))
      .sort(
        (a, b) =>
          new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
      );

    return paginate(filteredBlogs, {
      params: { year },
      pageSize: 6,
    });
  });
}

const { page } = Astro.props as { page: { data: BlogType[] } };
const { year } = Astro.params as { year: string };
---

<BaseLayout
  title={`${year} 年归档`}
  description={`${year} 年的全部文章`}
  author={siteConfig.author}
  url={`${siteConfig.url}/archive/${year}/${page.currentPage}`}
>
  <ArchiveDynamic
    years={years}
    page={page}
    posts={page.data}
    basePath={`/archive/${year}`}
    year={year}
  />
</BaseLayout>
