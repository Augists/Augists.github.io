---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { getCollection } from "astro:content";
import Pagination from "../../../components/Pagination.astro";
import type { BlogType } from "../../../content.config";
import { siteConfig } from "../../../config/site";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const blogs: BlogType[] = await getCollection("posts");
  const tags = [...new Set(blogs.flatMap((blog) => blog.data.tags))];

  return tags.flatMap((tag) => {
    const encodedTag = encodeURIComponent(tag);
    const filteredBlogs = blogs
      .filter((blog) => blog.data.tags.includes(tag))
      .sort(
        (a, b) =>
          new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
      );
    return paginate(filteredBlogs, {
      params: { tag: encodedTag },
      pageSize: 10,
    });
  });
}

const { page } = Astro.props as { page: { data: BlogType[] } };
const { tag } = Astro.params as { tag: string };
const decodedTag = decodeURIComponent(tag);
---

<BaseLayout
  title={`标签 | ${decodedTag}`}
  description={`与 ${decodedTag} 相关的文章`}
  author={siteConfig.author}
  url={`${siteConfig.url}/tags/${tag}/${page.currentPage}`}
>
  <div class="center">
    <h1 class="sub-heading">{decodedTag}</h1>
    <ul class="my-3 space-y-3">
      {
        page.data.map((blog: BlogType) => {
          return (
            <li>
              <PostCard
                title={blog.data.title}
                date={blog.data.date
                  .toLocaleDateString("en-GB", {
                    day: "numeric",
                    month: "short",
                  })
                  .slice(0, 11)}
                url={`/${blog.slug}`}
                tags={blog.data.tags}
              />
            </li>
          );
        })
      }
    </ul>
  </div>
  <Pagination page={page} />
</BaseLayout>
