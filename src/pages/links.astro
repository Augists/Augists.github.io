---
import BaseLayout from "../layouts/BaseLayout.astro";
import { friendLinks, siteConfig } from "../config/site";
---

<BaseLayout
  title="友链"
  description="朋友们的博客和站点"
  author={siteConfig.author}
  url={`${siteConfig.url}/links`}
>
  <div class="center">
    <h1 class="heading">友链</h1>
    {
      friendLinks.length ? (
        <ul class="grid list-none grid-cols-1 gap-3 px-0 sm:grid-cols-2 lg:grid-cols-3">
          {friendLinks.map((link) => {
            const hostname = (() => {
              try {
                return new URL(link.url).hostname.replace(/^www\./, "");
              } catch {
                return "";
              }
            })();

            return (
              <li class="ring-foreground/25 hover:ring-accent animation h-full rounded-xl border border-foreground/10 bg-foreground/3 p-3 ring-1 hover:bg-foreground/5">
                <a
                  class="group flex h-full items-start gap-3"
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.avatar ? (
                    <img
                      src={link.avatar}
                      alt={`${link.name} avatar`}
                      class="h-11 w-11 shrink-0 rounded-full border border-foreground/10 object-cover"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                  ) : (
                    <div class="h-11 w-11 shrink-0 rounded-full border border-foreground/10 bg-foreground/8" />
                  )}
                  <div class="min-w-0">
                    <p class="group-hover:text-accent animation truncate text-base font-semibold">
                      {link.name}
                    </p>
                    {hostname ? (
                      <p class="font-mono text-xs text-foreground/55">
                        {hostname}
                      </p>
                    ) : null}
                    {link.description ? (
                      <p class="mt-1 text-sm text-foreground/75">
                        {link.description}
                      </p>
                    ) : null}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="paragraph">
          暂时还没有添加友链，想交换的话可以通过页脚的邮箱或 Telegram 联系。
        </p>
      )
    }
  </div>
</BaseLayout>
