---
import { siteConfig } from "../config/site";
---

<div class="flex flex-wrap items-center justify-center gap-4 pb-8 text-sm">
  {
    siteConfig.socials.map((social) => (
      <a
        href={social.href}
        target={social.href.startsWith("http") ? "blank" : undefined}
        rel="noreferrer"
        class="navigation animation uppercase tracking-wide"
      >
        {social.label}
      </a>
    ))
  }
</div>
