---
import { getCollection } from "astro:content";
import type { BlogType } from "../content.config";
import FeatureCard from "./FeatureCard.astro";

const blogs: BlogType[] = await getCollection("posts");
const maxCandidates = 24;
const defaultVisible = 6;
const blogsWithReadTime = blogs
  .map((blog) => {
    const words = (blog.body ?? "").split(/\s+/).filter(Boolean).length;
    const minutes = Math.ceil(words / 200);
    return {
      ...blog,
      data: { ...blog.data, readTime: minutes },
    };
  })
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pinnedBlogs = blogsWithReadTime.filter((blog) => blog.data.featured);
const candidateBlogs =
  pinnedBlogs.length > 0
    ? [...pinnedBlogs, ...blogsWithReadTime.filter((blog) => !blog.data.featured)]
        .slice(0, maxCandidates)
    : blogsWithReadTime.slice(0, maxCandidates);
---

<h2 class="section-heading">最新文章</h2>
<ul
  class="grid gap-3 py-6 md:grid-cols-2"
  data-home-featured-list
  data-default-visible={defaultVisible}
>
  {
    candidateBlogs.map((blog: BlogType, index: number) => {
      return (
        <li data-home-featured-item hidden={index >= defaultVisible}>
          <FeatureCard
            title={blog.data.title}
            date={blog.data.date
              .toLocaleDateString("en-GB", {
                day: "numeric",
                month: "short",
                year: "numeric",
              })
              .slice(0, 11)}
            url={`/${blog.slug}`}
            tags={blog.data.tags}
            readTime={blog.data.readTime}
          />
        </li>
      );
    })
  }
</ul>

<script is:inline>
  (() => {
    const list = document.querySelector("[data-home-featured-list]");
    if (!list) return;

    const items = Array.from(
      list.querySelectorAll("[data-home-featured-item]"),
    );
    if (items.length === 0) return;

    let currentVisible = items.filter((i) => !i.hidden).length;

    const getColumns = () =>
      window.matchMedia("(min-width: 768px)").matches ? 2 : 1;

    const setVisible = (count) => {
      if (count === currentVisible) return;
      currentVisible = count;
      items.forEach((item, index) => {
        item.hidden = index >= count;
      });
    };

    const fitToViewport = () => {
      if (!document.contains(list)) return;

      const columns = getColumns();
      const firstItem = items[0];
      if (!firstItem || firstItem.hidden) { setVisible(columns); return; }

      // measure row height from existing visible items, no DOM mutation
      const gap = parseFloat(getComputedStyle(list).rowGap) || 12;
      const rowHeight = firstItem.getBoundingClientRect().height + gap;
      if (rowHeight <= 0) return;

      // fixed content below the list (hr + newsletter section)
      const listBottom = list.getBoundingClientRect().bottom;
      const newsletter = document.querySelector("[data-home-newsletter]");
      const newsletterBottom = newsletter
        ? newsletter.getBoundingClientRect().bottom
        : listBottom;
      const belowList = newsletterBottom - listBottom;

      // solve: listTop + rows * rowHeight - gap + belowList <= viewportH
      const listTop = list.getBoundingClientRect().top;
      const available = window.innerHeight - listTop - belowList + gap;
      const maxRows = Math.floor(available / rowHeight);
      const count = Math.max(columns, Math.min(maxRows * columns, items.length));

      setVisible(count);
    };

    let timer = 0;
    const schedule = () => {
      clearTimeout(timer);
      timer = window.setTimeout(fitToViewport, 120);
    };

    const init = () => {
      fitToViewport();
      window.addEventListener("resize", schedule, { passive: true });
      window.addEventListener("load", schedule, { once: true });
      document.fonts?.ready?.then?.(schedule).catch?.(() => {});
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init, { once: true });
    } else {
      init();
    }
  })();
</script>
